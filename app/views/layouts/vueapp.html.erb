<!DOCTYPE html>
<html>
  <head>
    <title>Boster Chat</title>

    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, user-scalable=0"/>

    <% if @global_config['DISPLAY_MANIFEST'] %>
      <meta name="msapplication-TileColor" content="#1D6EF5">
      <meta name="msapplication-TileImage" content="/ms-icon-144x144.png">
      <meta name="theme-color" content="#1D6EF5">
      <meta name="description" content="Boster Chat is a customer support solution that helps companies engage customers over Messenger, Twitter, Telegram, WeChat, Whatsapp. Simply connect your channels and converse with your customers from a single place.">

      <% if ENV['IOS_APP_IDENTIFIER'].present? %>
        <meta name="apple-itunes-app" content='app-id=<%= ENV['IOS_APP_IDENTIFIER'] %>'>
      <% end %>

      <link rel="apple-touch-icon" sizes="57x57"   href="/apple-icon-57x57.png">
      <link rel="apple-touch-icon" sizes="60x60"   href="/apple-icon-60x60.png">
      <link rel="apple-touch-icon" sizes="72x72"   href="/apple-icon-72x72.png">
      <link rel="apple-touch-icon" sizes="76x76"   href="/apple-icon-76x76.png">
      <link rel="apple-touch-icon" sizes="114x114" href="/apple-icon-114x114.png">
      <link rel="apple-touch-icon" sizes="120x120" href="/apple-icon-120x120.png">
      <link rel="apple-touch-icon" sizes="144x144" href="/apple-icon-144x144.png">
      <link rel="apple-touch-icon" sizes="152x152" href="/apple-icon-152x152.png">
      <link rel="apple-touch-icon" sizes="180x180" href="/apple-icon-180x180.png">

      <link rel="icon" type="image/png" sizes="192x192" href="/android-icon-192x192.png">
      <link class="favicon" rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
      <link class="favicon" rel="icon" type="image/png" sizes="96x96"  href="/favicon-96x96.png">
      <link class="favicon" rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">

      <link rel="manifest" href="/manifest.json">
    <% end %>

    <link rel="icon" type="image/png" sizes="512x512" href="<%= @global_config['LOGO_THUMBNAIL'] %>">

    <%= csrf_meta_tags %>

    <script nonce="<%= content_security_policy_nonce %>">
      window.chatwootConfig = {
        hostURL:                 '<%= ENV.fetch('FRONTEND_URL', '') %>',
        helpCenterURL:           '<%= ENV.fetch('HELPCENTER_URL', '') %>',
        fbAppId:                 '<%= @global_config['FB_APP_ID'] %>',
        instagramAppId:          '<%= @global_config['INSTAGRAM_APP_ID'] %>',
        tiktokAppId:             '<%= @global_config['TIKTOK_APP_ID'] %>',
        googleOAuthClientId:     '<%= ENV.fetch('GOOGLE_OAUTH_CLIENT_ID', nil) %>',
        googleOAuthCallbackUrl:  '<%= ENV.fetch('GOOGLE_OAUTH_CALLBACK_URL', nil) %>',
        allowedLoginMethods:     <%= @global_config['ALLOWED_LOGIN_METHODS'].to_json.html_safe %>,
        fbApiVersion:            '<%= @global_config['FACEBOOK_API_VERSION'] %>',
        whatsappAppId:           '<%= @global_config['WHATSAPP_APP_ID'] %>',
        whatsappConfigurationId: '<%= @global_config['WHATSAPP_CONFIGURATION_ID'] %>',
        whatsappApiVersion:      '<%= @global_config['WHATSAPP_API_VERSION'] %>',
        signupEnabled:           '<%= @global_config['ENABLE_ACCOUNT_SIGNUP'] %>',
        isEnterprise:            '<%= @global_config['IS_ENTERPRISE'] %>',
        isMfaEnabled:            '<%= Chatwoot.mfa_enabled? %>',
        <% if @global_config['IS_ENTERPRISE'] %>
        enterprisePlanName: '<%= @global_config['INSTALLATION_PRICING_PLAN'] %>',
        <% end %>
        <% if @global_config['VAPID_PUBLIC_KEY'] %>
        vapidPublicKey: new Uint8Array(<%= Base64.urlsafe_decode64(@global_config['VAPID_PUBLIC_KEY']).bytes %>),
        <% end %>
        enabledLanguages: <%= available_locales_with_name.to_json.html_safe %>,
        helpUrls:         <%= feature_help_urls.to_json.html_safe %>,
        selectedLocale:   '<%= I18n.locale %>'
      }
      window.globalConfig       = <%= raw @global_config.to_json %>
      window.browserConfig      = { browser_name: '<%= browser.name %>' }
      window.errorLoggingConfig = '<%= ENV.fetch('SENTRY_FRONTEND_DSN', '') || ENV.fetch('SENTRY_DSN', '') %>'
    </script>

    <% if @global_config['CLOUD_ANALYTICS_TOKEN'].present? %>
      <script nonce="<%= content_security_policy_nonce %>">
        window.analyticsConfig = { token: '<%= @global_config['CLOUD_ANALYTICS_TOKEN'] %>' }
      </script>
    <% end %>

    <%= vite_client_tag %>
    <%= vite_javascript_tag @application_pack %>

    <!-- ═══════════════════════════════════════════════════
         Boster Chat — Modern Blue Theme v4
         CSS selectors verified directly from DevTools:
           aside.bg-n-background   = sidebar
           div.size-6              = logo wrapper
           img.size-4              = logo image
           main.bg-n-surface-1     = content area
    ════════════════════════════════════════════════════ -->
    <style nonce="<%= content_security_policy_nonce %>">

      /* ── Design tokens ───────────────────────────────────── */
      :root {
        --b-blue:         #1D6EF5;
        --b-blue-dark:    #1450C8;
        --b-blue-navy:    #162F6A;
        --b-blue-light:   #EFF6FF;
        --b-blue-pale:    #F3F7FF;
        --b-blue-border:  #DBEAFE;
        --b-sidebar-icon: #7FB3FF;
        --b-white:        #FFFFFF;
        --b-radius:       10px;
      }

      /* ══════════════════════════════════════
         GLOBAL — font + body background
      ══════════════════════════════════════ */

      body, html {
        background: var(--b-blue-pale) !important;
      }

      #app {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif !important;
      }

      /* ══════════════════════════════════════
         LOGIN PAGE
      ══════════════════════════════════════ */

      /* Outer wrapper on login — Chatwoot uses flex min-h-screen */
      #app .flex.flex-col.w-full.h-screen,
      #app .flex.min-h-screen,
      #app [class*="min-h-screen"] {
        background:
          radial-gradient(ellipse 700px 500px at 15% 10%, rgba(29,110,245,0.12), transparent 60%),
          radial-gradient(ellipse 500px 400px at 85% 90%, rgba(29,110,245,0.08), transparent 55%),
          var(--b-blue-pale) !important;
      }

      /* Login card */
      #app section.bg-white,
      #app .bg-white.shadow,
      #app [class*="shadow"][class*="bg-white"] {
        border-radius: 20px !important;
        box-shadow: 0 8px 48px rgba(29,110,245,0.13), 0 1px 4px rgba(0,0,0,0.04) !important;
        border: 1px solid var(--b-blue-border) !important;
      }

      /* ══════════════════════════════════════
         SIDEBAR — exact class from DevTools:
         aside.bg-n-background (the left panel)
      ══════════════════════════════════════ */

      #app aside.bg-n-background,
      #app aside[class*="bg-n-background"] {
        background: var(--b-blue-navy) !important;
        border-right: 1px solid rgba(255,255,255,0.08) !important;
      }

      /* All text inside sidebar */
      #app aside.bg-n-background *,
      #app aside[class*="bg-n-background"] * {
        color: #C8DEFF !important;
      }

      /* Icons inside sidebar */
      #app aside.bg-n-background svg,
      #app aside[class*="bg-n-background"] svg {
        color: var(--b-sidebar-icon) !important;
        stroke: var(--b-sidebar-icon) !important;
      }

      /* Active nav item */
      #app aside.bg-n-background .active,
      #app aside[class*="bg-n-background"] .active,
      #app aside.bg-n-background [aria-current="page"],
      #app aside[class*="bg-n-background"] [aria-current="page"] {
        background: rgba(29,110,245,0.35) !important;
        border-radius: var(--b-radius) !important;
      }

      /* Hover */
      #app aside.bg-n-background a:hover,
      #app aside[class*="bg-n-background"] a:hover,
      #app aside.bg-n-background button:hover,
      #app aside[class*="bg-n-background"] button:hover {
        background: rgba(127,179,255,0.15) !important;
        border-radius: var(--b-radius) !important;
      }

      /* ── LOGO — exact selectors from DevTools ──────────────
         div.grid.flex-shrink-0.place-content-center.size-6
         img.size-4 (the actual logo image)
      ──────────────────────────────────────────────────── */

      /* Hide the logo image precisely */
      #app img.size-4,
      #app div.size-6 img,
      #app div.size-6 > img,
      #app [class*="place-content-center"] img {
        display: none !important;
        visibility: hidden !important;
      }

      /* Show "B" badge in the logo container */
      #app div.size-6::after,
      #app [class*="place-content-center"][class*="size-6"]::after {
        content: "B";
        display: flex !important;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        background: var(--b-blue);
        color: #fff;
        font-size: 15px;
        font-weight: 800;
        border-radius: 7px;
        font-family: 'Segoe UI', system-ui, sans-serif;
        letter-spacing: -0.3px;
        flex-shrink: 0;
      }

      /* ══════════════════════════════════════
         MAIN CONTENT AREA
         exact class from DevTools: main.bg-n-surface-1
      ══════════════════════════════════════ */

      #app main.bg-n-surface-1,
      #app main[class*="bg-n-surface-1"],
      #app [class*="bg-n-surface-1"] {
        background: var(--b-blue-pale) !important;
      }

      /* Conversation list panel */
      #app .flex.flex-col.h-full.bg-n-background,
      #app [class*="conversations-list"] {
        background: #F8FAFF !important;
        border-right: 1px solid var(--b-blue-border) !important;
      }

      /* Active conversation highlight */
      #app .active.conversation,
      #app [class*="conversation-item"].active,
      #app [class*="active"][class*="conversation"] {
        background: var(--b-blue-light) !important;
        border-left: 3px solid var(--b-blue) !important;
      }

      /* ══════════════════════════════════════
         HEADER / TOP BAR
      ══════════════════════════════════════ */

      #app header,
      #app .view-header,
      #app [class*="view-header"],
      #app [class*="page-header"] {
        background: var(--b-white) !important;
        border-bottom: 1px solid var(--b-blue-border) !important;
        box-shadow: 0 1px 6px rgba(29,110,245,0.06) !important;
      }

      /* ══════════════════════════════════════
         BUTTONS — brand blue
      ══════════════════════════════════════ */

      /* Chatwoot uses bg-woot-500 and bg-n-brand for primary buttons */
      #app [class*="bg-woot-500"],
      #app [class*="bg-n-brand"],
      #app [class*="bg-brand"],
      #app button[data-testid="submit_button"],
      #app button[type="submit"] {
        background: var(--b-blue) !important;
        border-color: var(--b-blue) !important;
        color: #fff !important;
      }

      #app [class*="bg-woot-500"]:hover,
      #app [class*="bg-n-brand"]:hover,
      #app button[type="submit"]:hover {
        background: var(--b-blue-dark) !important;
        border-color: var(--b-blue-dark) !important;
      }

      /* Outlined / ghost buttons with brand border */
      #app [class*="border-woot"],
      #app [class*="border-n-brand"],
      #app [class*="border-brand"] {
        border-color: var(--b-blue) !important;
        color: var(--b-blue) !important;
      }

      /* All buttons radius */
      #app button,
      #app [role="button"] {
        border-radius: var(--b-radius) !important;
      }

      /* ══════════════════════════════════════
         TEXT ACCENTS
      ══════════════════════════════════════ */

      #app [class*="text-woot"],
      #app [class*="text-n-brand"],
      #app [class*="text-brand"],
      #app a[class*="text-brand"] {
        color: var(--b-blue) !important;
      }

      /* Active tab indicator line */
      #app [class*="border-b-woot"],
      #app [class*="border-b-brand"],
      #app [class*="border-b-n-brand"] {
        border-bottom-color: var(--b-blue) !important;
        color: var(--b-blue) !important;
      }

      /* ══════════════════════════════════════
         INPUTS
      ══════════════════════════════════════ */

      #app input:focus,
      #app textarea:focus,
      #app select:focus {
        border-color: var(--b-blue) !important;
        box-shadow: 0 0 0 3px rgba(29,110,245,0.10) !important;
        outline: none !important;
      }

      /* ══════════════════════════════════════
         NOTIFICATION BADGES
      ══════════════════════════════════════ */

      #app [class*="badge"],
      #app .unread-badge,
      #app [class*="unread-count"] {
        background: var(--b-blue) !important;
        color: #fff !important;
      }

      /* ══════════════════════════════════════
         CARDS / PANELS
      ══════════════════════════════════════ */

      #app .bg-white.rounded-lg,
      #app [class*="bg-white"][class*="rounded"] {
        border: 1px solid var(--b-blue-border) !important;
        box-shadow: 0 2px 12px rgba(29,110,245,0.06) !important;
      }

      /* ══════════════════════════════════════
         SCROLLBARS
      ══════════════════════════════════════ */

      #app *::-webkit-scrollbar       { width: 5px; height: 5px; }
      #app *::-webkit-scrollbar-track { background: #EEF3FF; }
      #app *::-webkit-scrollbar-thumb { background: #BFDBFE; border-radius: 99px; }
      #app *::-webkit-scrollbar-thumb:hover { background: var(--b-blue); }

    </style>

    <!-- ═══════════════════════════════════════════════════
         Boster Chat — JS white-label engine
    ════════════════════════════════════════════════════ -->
    <script nonce="<%= content_security_policy_nonce %>">
    (function () {
      const BRAND_OLD       = 'Chatwoot';
      const BRAND_NEW       = 'Boster Chat';
      const BRAND_OLD_LOWER = 'chatwoot';

      function replaceBrandText(text) {
        if (!text) return text;
        return text
          .replace(/Chatwoot/g,  BRAND_NEW)
          .replace(/chatwoot/g,  'bosterchat')
          .replace(/CHATWOOT/g,  BRAND_NEW.toUpperCase());
      }

      function replaceTextNodes(root) {
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null, false);
        let node;
        while ((node = walker.nextNode())) {
          if (node.nodeValue && node.nodeValue.toLowerCase().includes(BRAND_OLD_LOWER)) {
            node.nodeValue = replaceBrandText(node.nodeValue);
          }
        }
      }

      function replaceAttributes(root) {
        const attrs = ['title', 'alt', 'placeholder', 'aria-label', 'content', 'value'];
        root.querySelectorAll('*').forEach(el => {
          attrs.forEach(attr => {
            const val = el.getAttribute(attr);
            if (val && val.toLowerCase().includes(BRAND_OLD_LOWER)) {
              el.setAttribute(attr, replaceBrandText(val));
            }
          });
          if ((el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') &&
              el.value && el.value.toLowerCase().includes(BRAND_OLD_LOWER)) {
            el.value = replaceBrandText(el.value);
          }
        });
      }

      function replaceMetaTags() {
        if (document.title.toLowerCase().includes(BRAND_OLD_LOWER)) {
          document.title = replaceBrandText(document.title);
        }
        document.querySelectorAll(
          'meta[name="application-name"], meta[property="og:site_name"], meta[name="description"]'
        ).forEach(meta => {
          const content = meta.getAttribute('content') || '';
          if (content.toLowerCase().includes(BRAND_OLD_LOWER)) {
            meta.setAttribute('content', replaceBrandText(content));
          }
        });
      }

      function observeChanges(root) {
        const observer = new MutationObserver(mutations => {
          for (const mutation of mutations) {
            if (mutation.type === 'childList') {
              mutation.addedNodes.forEach(node => {
                if (node.nodeType === Node.ELEMENT_NODE) {
                  replaceTextNodes(node);
                  replaceAttributes(node);
                } else if (node.nodeType === Node.TEXT_NODE) {
                  if (node.nodeValue && node.nodeValue.toLowerCase().includes(BRAND_OLD_LOWER)) {
                    node.nodeValue = replaceBrandText(node.nodeValue);
                  }
                }
              });
            } else if (mutation.type === 'characterData') {
              if (mutation.target.nodeValue &&
                  mutation.target.nodeValue.toLowerCase().includes(BRAND_OLD_LOWER)) {
                mutation.target.nodeValue = replaceBrandText(mutation.target.nodeValue);
              }
            }
          }
        });
        observer.observe(root, { childList: true, subtree: true, characterData: true });
      }

      function runAll() {
        const root = document.getElementById('app') || document.body;
        replaceTextNodes(root);
        replaceAttributes(root);
        replaceMetaTags();
        observeChanges(root);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', runAll);
      } else {
        runAll();
      }
    })();
    </script>

  </head>

  <body class="text-slate-600">
    <div id="app"></div>
    <noscript id="noscript">This app works best with JavaScript enabled.</noscript>
    <%= yield %>
    <% if @dashboard_scripts.present? %>
      <%= @dashboard_scripts.html_safe %>
    <% end %>
  </body>
</html>
