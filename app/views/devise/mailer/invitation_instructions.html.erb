<% content_for :title do %>You're invited to Boster Chat<% end %>

<table width="100%" cellpadding="0" cellspacing="0" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background:#f6f8fc; padding: 40px 0;">
  <tr>
    <td align="center">
      <table width="560" cellpadding="0" cellspacing="0" style="background:#ffffff; border-radius:16px; box-shadow:0 4px 24px rgba(2,6,23,0.08); overflow:hidden;">

        <!-- Header -->
        <tr>
          <td style="background: linear-gradient(135deg, #0F2A6E 0%, #1D6EF5 100%); padding: 36px 40px; text-align:center;">
            <table cellpadding="0" cellspacing="0" style="margin:0 auto;">
              <tr>
                <td style="background:white; border-radius:12px; padding:10px 20px;">
                  <span style="font-size:20px; font-weight:800; color:#1D6EF5; letter-spacing:-0.5px;">Boster</span><span style="font-size:20px; font-weight:400; color:#0F2A6E; letter-spacing:-0.5px;"> Chat</span>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Body -->
        <tr>
          <td style="padding: 40px 40px 32px;">
            <!-- Invite badge -->
            <table cellpadding="0" cellspacing="0" style="margin:0 0 20px;">
              <tr>
                <td style="background:#EFF6FF; border-radius:6px; padding:6px 14px;">
                  <span style="font-size:12px; font-weight:600; color:#1D6EF5; text-transform:uppercase; letter-spacing:1px;">Team Invitation</span>
                </td>
              </tr>
            </table>
            <h1 style="font-size:22px; font-weight:700; color:#0f172a; margin:0 0 16px;">You've been invited to join Boster Chat</h1>
            <p style="font-size:15px; color:#475569; line-height:1.7; margin:0 0 24px;">
              You've been invited to join the <strong>Boster Chat</strong> team. Click the button below to accept your invitation and set up your account.
            </p>
            <table cellpadding="0" cellspacing="0" style="margin: 0 0 24px;">
              <tr>
                <td style="background: linear-gradient(135deg, #1D6EF5, #0F2A6E); border-radius:10px; padding:14px 28px;">
                  <a href="<%= accept_invitation_url(@resource, invitation_token: @token) %>" style="color:#ffffff; font-size:15px; font-weight:600; text-decoration:none; display:block;">
                    Accept invitation →
                  </a>
                </td>
              </tr>
            </table>
            <p style="font-size:13px; color:#94a3b8; line-height:1.6; margin:0;">
              This invitation link will expire in <%= pluralize(Devise.invite_for / 86400, "day") %>. If you weren't expecting this invitation, you can safely ignore this email.
            </p>
          </td>
        </tr>

        <!-- Footer -->
        <tr>
          <td style="background:#f8fafc; border-top:1px solid #e2e8f0; padding:24px 40px; text-align:center;">
            <p style="font-size:12px; color:#94a3b8; margin:0;">
              © <%= Time.current.year %> Boster Chat. All rights reserved.
            </p>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>
